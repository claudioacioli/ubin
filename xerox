  fi
  
  if [[ ! -f "$EL_PATH/test.php" ]]; then
    echo "❌ Arquivo test.php não encontrado em: $EL_PATH"
    exit 1
  fi
  
  echo "🧪 Testando element: $EL_PATH"
  echo ""
  
  local TEST_OUTPUT
  if TEST_OUTPUT=$(cd "$EL_PATH" && php test.php 2>&1); then
    echo "$TEST_OUTPUT"
    return 0
  else
    echo "$TEST_OUTPUT"
    echo ""
    echo "❌ Teste falhou"
    return 1
  fi
}

# ============================================================
# COMANDO: STUB
# ============================================================

run_stub() {
  local NAME_ARG="$1"
  local OUTPUT="${2:-$ATOM_OUTPUT}"
  
  if [[ -z "$NAME_ARG" ]]; then
    echo "❌ name não definido"
    echo "uso: atom stub <name>:<namespace> [destino]"
    exit 1
  fi
  
  if [[ -z "$OUTPUT" ]]; then
    echo "❌ Destino não definido"
    echo ""
    echo "opções:"
    echo "  atom stub email ./elements"
    echo "  export ATOM_OUTPUT=/path/to/elements"
    exit 1
  fi
  
  if [[ ! -d "$OUTPUT" ]]; then
    echo "❌ Diretório não existe: $OUTPUT"
    exit 1
  fi
  
  # Parse name:namespace
  local NAME="${NAME_ARG%%:*}"
  local NS_SUFFIX="${NAME_ARG#*:}"
  
  if [[ "$NAME" == "$NS_SUFFIX" ]]; then
    # Só passou name, namespace = Name (PascalCase)
    # Converte kebab-case para PascalCase
    NS_SUFFIX=$(echo "$NAME" | sed -r 's/(^|-)([a-z])/\U\2/g')
  fi
  
  local EL_PATH="$OUTPUT/$NAME"
  local EL_NS="Elements\\$NS_SUFFIX"
  local EXCEPTION_NAME="Invalid${NS_SUFFIX}Exception"
  
  if [[ -d "$EL_PATH" ]]; then
    echo "❌ Element já existe: $EL_PATH"
    exit 1
  fi
  
  mkdir -p "$EL_PATH/src"
  
  echo "🔧 Criando element: $NAME"
  echo "   Namespace: $EL_NS"
  
  # ============================================================
  # RESOLVE DEPENDÊNCIAS (reativo)
  # ============================================================
  
  REPOS_JSON="[]"
  REQUIRE_JSON="{\"php\":\"^8.3\"}"
  
  add_dependency() {
    local pkg="$1"
    local pkg_path=""
    
    pkg_path=$(cd "$WORK_DIR" && recompose path "$pkg")
    
    if [[ -z "$pkg_path" ]]; then
      return 1
    fi
    
    REPOS_JSON=$(echo "$REPOS_JSON" | sed 's/\]$//')
    [[ "$REPOS_JSON" != "[" ]] && REPOS_JSON="$REPOS_JSON,"
    REPOS_JSON="$REPOS_JSON{\"type\":\"path\",\"url\":\"$pkg_path\",\"options\":{\"symlink\":true}}]"
    
    REQUIRE_JSON=$(echo "$REQUIRE_JSON" | sed 's/\}$//')
    REQUIRE_JSON="$REQUIRE_JSON,\"$pkg\":\"@dev\"}"
    
    return 0
  }
  
  write_composer() {
    local EL_NS_ESCAPED=$(echo "$EL_NS" | sed 's/\\/\\\\/g')
    cat > "$EL_PATH/composer.json" <<JSON
{
    "name": "elements/$NAME",
    "description": "$NS_SUFFIX atomic value object",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "${EL_NS_ESCAPED}\\\\": "src/"
        }
    },
    "repositories": $REPOS_JSON,
    "require": $REQUIRE_JSON,
    "minimum-stability": "dev",
    "prefer-stable": true
}
JSON
  }
  
  write_atom() {
    cat > "$EL_PATH/src/Atom.php" <<PHP
<?php
declare(strict_types=1);
namespace ${EL_NS};

use Pocket\\Atom\\Abstracts\\Proton;
use Pocket\\Atom\\Exceptions\\AtomException;

final readonly class Atom extends Proton
{
    protected static function normalize(mixed \$value): string
    {
        // TODO: implementar normalização
        return trim((string) \$value);
    }

    protected static function isValid(mixed \$value): bool
    {
        // TODO: implementar validação
        return \$value !== '';
    }

    protected static function exception(
        mixed \$raw,
        mixed \$normalized
    ): AtomException {
        return new ${EXCEPTION_NAME}(
            raw: \$raw,
            normalized: \$normalized,
            message: "Invalid ${NS_SUFFIX}: {\$raw}"
        );
    }
}
PHP
  }
  
  write_exception() {
    cat > "$EL_PATH/src/${EXCEPTION_NAME}.php" <<PHP
<?php
declare(strict_types=1);
namespace ${EL_NS};

use Pocket\\Atom\\Exceptions\\AtomException;

final class ${EXCEPTION_NAME} extends AtomException {}
PHP
  }
  
  write_test() {
    cat > "$EL_PATH/test.php" <<PHP
<?php
declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

use ${EL_NS}\\Atom;
use ${EL_NS}\\${EXCEPTION_NAME};

echo "🔍 Verificando autoload...\\n";

if (!class_exists(Atom::class)) {
    echo "❌ Classe Atom não encontrada\\n";
    exit(1);
}
echo "   ✅ Atom carregada\\n";

if (!class_exists(${EXCEPTION_NAME}::class)) {
    echo "❌ Classe ${EXCEPTION_NAME} não encontrada\\n";
    exit(1);
}
echo "   ✅ ${EXCEPTION_NAME} carregada\\n";

echo "🔍 Verificando herança...\\n";

\$ref = new ReflectionClass(Atom::class);
if (!\$ref->isSubclassOf('Pocket\\Atom\\Abstracts\\Proton')) {
    echo "❌ Atom não extende Proton\\n";
    exit(1);
}
echo "   ✅ Atom extende Proton\\n";

\$exRef = new ReflectionClass(${EXCEPTION_NAME}::class);
if (!\$exRef->isSubclassOf('Pocket\\Atom\\Exceptions\\AtomException')) {
    echo "❌ ${EXCEPTION_NAME} não extende AtomException\\n";
    exit(1);
}
echo "   ✅ ${EXCEPTION_NAME} extende AtomException\\n";

echo "🔍 Verificando instanciação...\\n";

try {
    \$atom = Atom::from('test_value');
    echo "   ✅ Atom::from() funciona\\n";
    echo "   ✅ Valor: " . \$atom->value() . "\\n";
} catch (${EXCEPTION_NAME} \$e) {
    echo "   ⚠️  Atom::from('test_value') lançou exceção (validação customizada)\\n";
}

echo "\\n✅ Todos os testes passaram!\\n";
echo "\\n📝 TODO: implementar normalize() e isValid() em src/Atom.php\\n";
PHP
  }
  
  # Adiciona pocket/atom
  echo "📦 Resolvendo dependências..."
  add_dependency "pocket/atom" || cleanup_and_exit "pocket/atom não encontrado" "$EL_PATH"
  
  write_atom
  write_exception
  write_composer
  write_test
  
  # Roda composer (reativo)
  MAX_ATTEMPTS=20
  ATTEMPT=0
  
  while [[ $ATTEMPT -lt $MAX_ATTEMPTS ]]; do
    ATTEMPT=$((ATTEMPT + 1))
    
    COMPOSER_OUTPUT=$(cd "$EL_PATH" && composer update --no-interaction 2>&1) && break
    
    MISSING=$(echo "$COMPOSER_OUTPUT" | grep -oP "[a-z0-9_-]+/[a-z0-9_-]+(?= @dev -> could not be found)" | head -1)
    
    if [[ -z "$MISSING" ]]; then
      cleanup_and_exit "Erro não tratável:\n$COMPOSER_OUTPUT" "$EL_PATH"
    fi
    
    echo "   ➕ [$ATTEMPT] $MISSING"
    
    if ! add_dependency "$MISSING"; then
      cleanup_and_exit "Não foi possível resolver: $MISSING" "$EL_PATH"
    fi
    
    write_composer
  done
  
  if [[ $ATTEMPT -ge $MAX_ATTEMPTS ]]; then
    cleanup_and_exit "Máximo de tentativas atingido ($MAX_ATTEMPTS)" "$EL_PATH"
  fi
  
  echo ""
  echo "✅ Element criado: $EL_PATH"
  echo "   Dependências resolvidas em $ATTEMPT tentativa(s)"
  
  echo ""
  run_test "$EL_PATH"
}

