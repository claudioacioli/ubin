#!/usr/bin/env bash
set -e

# ============================================================
# ENTITY CLI - Gerador de Entidades
# ============================================================

WORK_DIR="$(pwd)"

# ============================================================
# HELP
# ============================================================

show_help() {
  echo "ENTITY - Gerador de Entidades"
  echo ""
  echo "uso:"
  echo "  entity name:<name>:<namespace> props:\"<props>\" [destino]"
  echo "  entity test <path>"
  echo ""
  echo "props format:"
  echo "  Encapsulamento: - (private), ~ (protected, default), + (public)"
  echo "  Nullable: ? antes do tipo"
  echo "  Tipo maiúsculo = Element, minúsculo = primitivo"
  echo ""
  echo "  Integral:  \"email:?Email\" → protected ?Email \$email"
  echo "  Shorthand: \"?Email\" → protected ?Email \$email"
  echo "  Shorthand: \"?email\" → protected ?string \$email"
  echo "  Visibility: \"-?Email\" → private ?Email \$email"
  echo ""
  echo "exemplo:"
  echo "  entity name:ecpf:eCPF props:\"Id|Id:pessoa_fisica_id|?Email|?Name:nome_titular\" ./entities"
  echo ""
  echo "variáveis de ambiente:"
  echo "  ENTITY_OUTPUT   diretório padrão para entidades"
  echo ""
  echo "requer: recompose, pkg-ls no PATH"
}

cleanup_and_exit() {
  local msg="$1"
  local path="$2"
  echo "❌ $msg"
  if [[ -n "$path" && -d "$path" ]]; then
    rm -rf "$path"
    echo "🧹 Removido: $path"
  fi
  exit 1
}

# ============================================================
# TEST
# ============================================================

run_test() {
  local ENT_PATH="$1"

  [[ -z "$ENT_PATH" ]] && exit 1
  [[ ! -d "$ENT_PATH" ]] && exit 1
  [[ ! -f "$ENT_PATH/test.php" ]] && exit 1

  echo "🧪 Testando entidade: $ENT_PATH"
  echo ""

  (cd "$ENT_PATH" && php test.php)
}

# ============================================================
# PARSER DE PROPRIEDADES
# ============================================================

declare -a PROP_NAMES=()
declare -a PROP_TYPES=()
declare -a PROP_VISIBILITIES=()
declare -a PROP_NULLABLES=()
declare -a PROP_IS_ELEMENT=()
declare -a ELEMENT_TYPES=()

reset_props() {
  PROP_NAMES=()
  PROP_TYPES=()
  PROP_VISIBILITIES=()
  PROP_NULLABLES=()
  PROP_IS_ELEMENT=()
  ELEMENT_TYPES=()
}

parse_props() {
  IFS='|' read -ra PROPS <<< "$1"
  for prop in "${PROPS[@]}"; do
    parse_single_prop "$prop"
  done
}

parse_single_prop() {
  local prop="$(echo "$1" | xargs)"
  local visibility="protected"
  local nullable=""
  local type=""
  local name=""
  local is_element="false"

  case "${prop:0:1}" in
    "-") visibility="private"; prop="${prop:1}" ;;
    "+") visibility="public";  prop="${prop:1}" ;;
    "~") visibility="protected"; prop="${prop:1}" ;;
  esac

  [[ "${prop:0:1}" == "?" ]] && nullable="?" && prop="${prop:1}"

  if [[ "$prop" == *":"* ]]; then
    local a="${prop%%:*}"
    local b="${prop#*:}"

    if [[ "${a:0:1}" =~ [A-Z] ]] || [[ "$a" =~ ^(string|int|bool|float|array|mixed)$ ]]; then
      type="$a"; name="$b"
    else
      name="$a"; type="$b"
      [[ "${type:0:1}" == "?" ]] && nullable="?" && type="${type:1}"
    fi
  else
    type="$prop"
  fi

  if [[ "${type:0:1}" =~ [A-Z] ]]; then
    is_element="true"
    [[ -z "$name" ]] && name=$(echo "$type" | sed 's/\([A-Z]\)/_\L\1/g' | sed 's/^_//')
  else
    is_element="false"
    [[ ! "$type" =~ ^(string|int|bool|float|array|mixed)$ ]] && name="$type" && type="string"
    [[ -z "$name" ]] && name="$type"
  fi

  PROP_NAMES+=("$name")
  PROP_TYPES+=("$type")
  PROP_VISIBILITIES+=("$visibility")
  PROP_NULLABLES+=("$nullable")
  PROP_IS_ELEMENT+=("$is_element")

  if [[ "$is_element" == "true" && ! " ${ELEMENT_TYPES[*]} " =~ " $type " ]]; then
    ELEMENT_TYPES+=("$type")
  fi
}

# ============================================================
# CATÁLOGO DE ELEMENTS (CONTRATO REAL)
# ============================================================

declare -A ELEMENT_PACKAGE_MAP=()
declare -A ELEMENT_NAMESPACE_MAP=()

load_elements_catalog() {
  while IFS=',' read -r pkg ns _ _; do
    local slug="$(basename "$pkg")"
    local pascal="${ns##*\\}"

    ELEMENT_PACKAGE_MAP["$pascal"]="$pkg"
    ELEMENT_PACKAGE_MAP["$slug"]="$pkg"

    ELEMENT_NAMESPACE_MAP["$pascal"]="$ns"
    ELEMENT_NAMESPACE_MAP["$slug"]="$ns"
  done < <(pkg-ls -f csv elements)
}

resolve_element_package() {
  local etype="$1"
  local slug
  slug=$(echo "$etype" | sed 's/\([A-Z]\)/-\L\1/g' | sed 's/^-//')

  [[ -n "${ELEMENT_PACKAGE_MAP[$etype]}" ]] && echo "${ELEMENT_PACKAGE_MAP[$etype]}" && return 0
  [[ -n "${ELEMENT_PACKAGE_MAP[$slug]}"  ]] && echo "${ELEMENT_PACKAGE_MAP[$slug]}"  && return 0
  return 1
}

# ============================================================
# CREATE
# ============================================================

run_create() {
  reset_props

  local NAME_ARG=""
  local PROPS_ARG=""
  local OUTPUT=""

  for arg in "$@"; do
    case "$arg" in
      name:*)  NAME_ARG="${arg#name:}" ;;
      props:*) PROPS_ARG="${arg#props:}" ;;
      *)       OUTPUT="$arg" ;;
    esac
  done

  OUTPUT="${OUTPUT:-$ENTITY_OUTPUT}"
  [[ -z "$NAME_ARG" || -z "$PROPS_ARG" || ! -d "$OUTPUT" ]] && exit 1

  local NAME="${NAME_ARG%%:*}"
  local NS_SUFFIX="${NAME_ARG#*:}"
  [[ "$NAME" == "$NS_SUFFIX" ]] && NS_SUFFIX="${NAME^}"

  local ENT_PATH="$OUTPUT/$NAME"
  local ENT_NS="Entities\\$NS_SUFFIX"

  [[ -d "$ENT_PATH" ]] && exit 1
  mkdir -p "$ENT_PATH/src"

  echo "🔧 Criando entidade: $NAME"
  echo "   Namespace: $ENT_NS"

  parse_props "$PROPS_ARG"
  load_elements_catalog

  REPOS_JSON="[]"
  REQUIRE_JSON="{\"php\":\"^8.3\""

  add_dependency() {
    local pkg="$1"
    local path
    path=$(cd "$WORK_DIR" && recompose path "$pkg") || return 1

    REPOS_JSON="${REPOS_JSON%]}"
    [[ "$REPOS_JSON" != "[" ]] && REPOS_JSON+=","
    REPOS_JSON+="{\"type\":\"path\",\"url\":\"$path\",\"options\":{\"symlink\":true}}]"

    REQUIRE_JSON="${REQUIRE_JSON%}"
    REQUIRE_JSON+=",\"$pkg\":\"@dev\""
  }

  add_dependency "pocket/entity"
  REQUIRE_JSON+="}"

  echo ""
  echo "📦 Resolvendo Elements..."

  for etype in "${ELEMENT_TYPES[@]}"; do
    pkg=$(resolve_element_package "$etype") \
      || cleanup_and_exit "Element não encontrado no catálogo: $etype" "$ENT_PATH"

    echo "   ➕ $pkg"
    add_dependency "$pkg"
  done

  # ===============================
  # GERAR ENTITY
  # ===============================

  local uses=""
  local props=""

  for etype in "${ELEMENT_TYPES[@]}"; do
    ns="${ELEMENT_NAMESPACE_MAP[$etype]}"
    class="Atom"
    [[ "$etype" =~ Hash$ ]] && class="Hash"
    uses+="use ${ns}\\${class} as ${etype};"$'\n'
  done

  for i in "${!PROP_NAMES[@]}"; do
    props+="        ${PROP_VISIBILITIES[$i]} ${PROP_NULLABLES[$i]}${PROP_TYPES[$i]} \$${PROP_NAMES[$i]},"$'\n'
  done

  props="${props%,}"

  cat > "$ENT_PATH/src/Entity.php" <<PHP
<?php
declare(strict_types=1);
namespace ${ENT_NS};

${uses}
use Pocket\\Entity\\Abstracts\\Entity as AbstractEntity;

final readonly class Entity extends AbstractEntity
{
    public function __construct(
${props}
    ) {}
}
PHP

  cat > "$ENT_PATH/composer.json" <<JSON
{
  "name": "entities/$NAME",
  "type": "library",
  "autoload": { "psr-4": { "${ENT_NS//\\/\\\\}\\\\": "src/" } },
  "repositories": $REPOS_JSON,
  "require": $REQUIRE_JSON,
  "minimum-stability": "dev"
}
JSON

  cat > "$ENT_PATH/test.php" <<PHP
<?php
require __DIR__.'/vendor/autoload.php';
use ${ENT_NS}\\Entity;
new ReflectionClass(Entity::class);
echo "✅ OK\n";
PHP

  (cd "$ENT_PATH" && composer update --no-interaction)
  run_test "$ENT_PATH"
}

# ============================================================
# MAIN
# ============================================================

[[ -z "$1" ]] && show_help && exit 0

case "$1" in
  test) run_test "$2" ;;
  -h|--help|help) show_help ;;
  *) run_create "$@" ;;
esac
#!/usr/bin/env bash
set -e

# ============================================================
# CASSETE CLI - Gerador de Data Layers
# ============================================================

WORK_DIR="$(pwd)"
CMD="$1"

show_help() {
  echo "CASSETE - Gerador de Data Layers"
  echo ""
  echo "uso:"
  echo "  cassete <name>:<provider>:<entity>:<namespace> [destino]"
  echo "  cassete test <path>"
  echo "  cassete list [destino]                             lista data-layers gerados"
  echo ""
  echo "exemplos:"
  echo "  cassete ecpf:mongo:entities/ecpf:eCPF ./data"
  echo "  cassete test ./data/ecpf"
  echo ""
  echo "variáveis de ambiente:"
  echo "  CASSETE_OUTPUT   diretório padrão para data"
  echo "  CASSETE_PATH     diretório raiz do cassete (obrigatório)"
  echo ""
  echo "requer: recompose no PATH"
}

cleanup_and_exit() {
  local msg="$1"
  local path="$2"
  echo "❌ $msg"
  if [[ -n "$path" && -d "$path" ]]; then
    rm -rf "$path"
    echo "🧹 Removido: $path"
  fi
  exit 1
}


# ============================================================
# COMANDO: LIST
# ============================================================
run_list() {
  local SEARCH_PATH="${1:-$CASSETE_OUTPUT}"
  
  # Configuração de larguras (Manutenção Centralizada)
  local W_NAME=15
  local W_PROV=15
  local W_NS=30
  local W_ENT=20

  # Função interna para truncar strings
  truncate_str() {
    local str="$1"
    local max=$2
    if [ ${#str} -gt $max ]; then
      echo "${str:0:$((max-3))}..."
    else
      echo "$str"
    fi
  }

  if [[ -z "$SEARCH_PATH" || ! -d "$SEARCH_PATH" ]]; then
    echo "❌ Diretório não encontrado: $SEARCH_PATH"
    exit 1
  fi

  echo "📂 Inventário de Data Layers"
  echo ""
  
  # Cabeçalho dinâmico
  printf "%-${W_NAME}s | %-${W_PROV}s | %-${W_NS}s | %-${W_ENT}s\n" "NOME" "PROVIDER" "NAMESPACE" "ENTIDADE"
  printf "%.s-" $(seq 1 $((W_NAME + W_PROV + W_NS + W_ENT + 9)))
  echo ""

  for dir in "$SEARCH_PATH"/*; do
    if [[ -d "$dir" && -f "$dir/composer.json" ]]; then
      # Coleta de dados
      local raw_name=$(basename "$dir")
      local raw_prov=$(jq -r '.require | keys[] | select(contains("cassete/")) | select(. != "cassete/runtime")' "$dir/composer.json" | sed 's/cassete\///' | tr '\n' ',' | sed 's/,$//')
      [[ -z "$raw_prov" ]] && raw_prov="custom"
      
      local raw_ns=$(jq -r '.autoload["psr-4"] // {} | keys[0] // "N/A"' "$dir/composer.json" | sed 's/\\$//')
      
      local raw_ent="N/A"
      [[ -f "$dir/src/Factory.php" ]] && raw_ent=$(grep "use .*Entity;" "$dir/src/Factory.php" | awk '{print $2}' | sed 's/Entity;//')

      # Exibição com truncamento preventivo
      printf "%-${W_NAME}s | %-${W_PROV}s | %-${W_NS}s | %-${W_ENT}s\n" \
        "$(truncate_str "$raw_name" $W_NAME)" \
        "$(truncate_str "$raw_prov" $W_PROV)" \
        "$(truncate_str "$raw_ns" $W_NS)" \
        "$(truncate_str "$raw_ent" $W_ENT)"
    fi
  done
}

# ============================================================
# COMANDO: TEST
# ============================================================

run_test() {
  local DL_PATH="$1"
  
  if [[ -z "$DL_PATH" ]]; then
    echo "uso: cassete test <path>"
    exit 1
  fi
  
  if [[ ! -d "$DL_PATH" ]]; then
    echo "❌ Diretório não existe: $DL_PATH"
    exit 1
  fi
  
  if [[ ! -f "$DL_PATH/composer.json" ]]; then
    echo "❌ Não é um data válido: $DL_PATH"
    exit 1
  fi
  
  echo "🧪 Testando data: $DL_PATH"
  
  local DL_NS=$(jq -r '.autoload["psr-4"] // {} | keys[0] // ""' "$DL_PATH/composer.json" | sed 's/\\$//')
  
  if [[ -z "$DL_NS" ]]; then
    echo "❌ Namespace não encontrado"
    exit 1
  fi
  
  echo "   Namespace: $DL_NS"
  
  cat > "$DL_PATH/test.php" <<PHP
<?php
declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

echo "🔍 Verificando autoload...\\n";

\$documentClass = '${DL_NS}\\\\Document';
\$gatewayClass = '${DL_NS}\\\\Gateway';
\$factoryClass = '${DL_NS}\\\\Factory';

if (!class_exists(\$documentClass)) {
    echo "❌ Classe não encontrada: \$documentClass\\n";
    exit(1);
}
echo "   ✅ \$documentClass\\n";

if (!class_exists(\$gatewayClass)) {
    echo "❌ Classe não encontrada: \$gatewayClass\\n";
    exit(1);
}
echo "   ✅ \$gatewayClass\\n";

if (!class_exists(\$factoryClass)) {
    echo "❌ Classe não encontrada: \$factoryClass\\n";
    exit(1);
}
echo "   ✅ \$factoryClass\\n";

echo "🔍 Verificando herança...\\n";

\$docRef = new ReflectionClass(\$documentClass);
if (!\$docRef->isSubclassOf('Cassete\\\\Runtime\\\\Abstracts\\\\Document')) {
    echo "❌ Document não extende AbstractDocument\\n";
    exit(1);
}
echo "   ✅ Document extende AbstractDocument\\n";

\$gwRef = new ReflectionClass(\$gatewayClass);
if (!\$gwRef->isSubclassOf('Cassete\\\\Runtime\\\\Abstracts\\\\Gateway')) {
    echo "❌ Gateway não extende AbstractGateway\\n";
    exit(1);
}
echo "   ✅ Gateway extende AbstractGateway\\n";

\$factRef = new ReflectionClass(\$factoryClass);
if (!\$factRef->isSubclassOf('Pocket\\\\Entity\\\\Abstracts\\\\Factory')) {
    echo "❌ Factory não extende AbstractFactory\\n";
    exit(1);
}
echo "   ✅ Factory extende AbstractFactory\\n";

echo "🔍 Verificando #[Attr]...\\n";

\$docAttrs = \$docRef->getAttributes();
if (empty(\$docAttrs)) {
    echo "❌ Document sem #[Attr]\\n";
    exit(1);
}
echo "   ✅ Document tem #[Attr]\\n";

\$gwAttrs = \$gwRef->getAttributes();
if (empty(\$gwAttrs)) {
    echo "❌ Gateway sem #[Attr]\\n";
    exit(1);
}
echo "   ✅ Gateway tem #[Attr]\\n";

echo "\\n✅ Todos os testes passaram!\\n";
PHP

  echo ""
  echo "📦 Executando teste..."
  echo ""
  
  local TEST_OUTPUT
  if TEST_OUTPUT=$(cd "$DL_PATH" && php test.php 2>&1); then
    echo "$TEST_OUTPUT"
    rm -f "$DL_PATH/test.php"
    return 0
  else
    echo "$TEST_OUTPUT"
    echo ""
    echo "❌ Teste falhou"
    rm -f "$DL_PATH/test.php"
    return 1
  fi
}

# ============================================================
# COMANDO: CREATE
# ============================================================

run_create() {
  local INPUT="$1"
  local OUTPUT="${2:-$CASSETE_OUTPUT}"
  
  if [[ -z "$CASSETE_PATH" ]]; then
    echo "❌ CASSETE_PATH não definido"
    echo "ex: export CASSETE_PATH=/home/acioli/Clean/pockets/cassete"
    exit 1
  fi
  
  if [[ "$INPUT" != *":"*":"*":"* ]]; then
    echo "❌ Formato inválido: $INPUT"
    echo "uso: cassete <name>:<provider>:<entity>:<namespace>"
    exit 1
  fi
  
  if [[ -z "$OUTPUT" ]]; then
    echo "❌ Destino não definido"
    echo ""
    echo "opções:"
    echo "  cassete ecpf:mongo:entities/ecpf:eCPF ./data"
    echo "  export CASSETE_OUTPUT=/path/to/data"
    exit 1
  fi
  
  if [[ ! -d "$OUTPUT" ]]; then
    echo "❌ Diretório não existe: $OUTPUT"
    exit 1
  fi
  
  IFS=':' read -r NAME PROVIDER ENTITY DL_NS_SUFFIX <<< "$INPUT"
  
  DL_PATH="$OUTPUT/$NAME"
  DL_NS="Data\\$DL_NS_SUFFIX"
  
  if [[ -d "$DL_PATH" ]]; then
    echo "❌ Data já existe: $DL_PATH"
    exit 1
  fi
  
  mkdir -p "$DL_PATH/src"
  
  echo "🔧 Criando data: $NAME"
  
  # ============================================================
  # RESOLVE DEPENDÊNCIAS (reativo)
  # ============================================================
  
  REPOS_JSON="[]"
  REQUIRE_JSON="{\"php\":\"^8.3\"}"
  
  add_dependency() {
    local pkg="$1"
    local pkg_path=""
    
    if [[ "$pkg" == "cassete/"* ]]; then
      local subpkg="${pkg#cassete/}"
      if [[ -d "$CASSETE_PATH/$subpkg" ]]; then
        pkg_path="$CASSETE_PATH/$subpkg"
      elif [[ -d "$CASSETE_PATH/providers/$subpkg" ]]; then
        pkg_path="$CASSETE_PATH/providers/$subpkg"
      fi
    fi
    
    if [[ -z "$pkg_path" ]]; then
      pkg_path=$(cd "$WORK_DIR" && recompose path "$pkg")
    fi
    
    if [[ -z "$pkg_path" ]]; then
      return 1
    fi
    
    REPOS_JSON=$(echo "$REPOS_JSON" | sed 's/\]$//')
    [[ "$REPOS_JSON" != "[" ]] && REPOS_JSON="$REPOS_JSON,"
    REPOS_JSON="$REPOS_JSON{\"type\":\"path\",\"url\":\"$pkg_path\",\"options\":{\"symlink\":true}}]"
    
    REQUIRE_JSON=$(echo "$REQUIRE_JSON" | sed 's/\}$//')
    REQUIRE_JSON="$REQUIRE_JSON,\"$pkg\":\"@dev\"}"
    
    return 0
  }
  
  write_composer() {
    local DL_NS_ESCAPED=$(echo "$DL_NS" | sed 's/\\/\\\\/g')
    cat > "$DL_PATH/composer.json" <<JSON
{
    "name": "data/$NAME",
    "type": "library",
    "autoload": {
        "psr-4": {
            "${DL_NS_ESCAPED}\\\\": "src/"
        }
    },
    "repositories": $REPOS_JSON,
    "require": $REQUIRE_JSON,
    "minimum-stability": "dev"
}
JSON
  }
  
  write_sources() {
    local entity_ns="$1"
    
    cat > "$DL_PATH/src/Document.php" <<PHP
<?php
declare(strict_types=1);
namespace ${DL_NS};

use Cassete\\Runtime\\Attributes\\Attr;
use Cassete\\Runtime\\Abstracts\\Document as AbstractDocument;

#[Attr(target: Factory::class)]
readonly class Document extends AbstractDocument {}
PHP

    cat > "$DL_PATH/src/Gateway.php" <<PHP
<?php
declare(strict_types=1);
namespace ${DL_NS};

use Cassete\\Runtime\\Attributes\\Attr;
use Cassete\\Runtime\\Abstracts\\Gateway as AbstractGateway;

#[Attr(target: Document::class)]
readonly class Gateway extends AbstractGateway {}
PHP

    cat > "$DL_PATH/src/Factory.php" <<PHP
<?php
declare(strict_types=1);
namespace ${DL_NS};

use ${entity_ns}Entity;
use Pocket\\Entity\\Abstracts\\Factory as AbstractFactory;

class Factory extends AbstractFactory {
    protected static function entity(): string
    {
        return Entity::class;
    }
}
PHP
  }
  
  add_dependency "cassete/runtime" || cleanup_and_exit "Runtime não encontrado" "$DL_PATH"
  add_dependency "cassete/$PROVIDER" || cleanup_and_exit "Provider não encontrado: $PROVIDER" "$DL_PATH"
  add_dependency "$ENTITY" || cleanup_and_exit "Entidade não encontrada: $ENTITY" "$DL_PATH"
  
  ENTITY_NS=$(cd "$WORK_DIR" && recompose ns "$ENTITY")
  
  [[ -z "$ENTITY_NS" ]] && cleanup_and_exit "Namespace não encontrado para: $ENTITY" "$DL_PATH"
  
  write_sources "$ENTITY_NS"
  write_composer
  
  echo "   Namespace: $DL_NS"
  echo "   Runtime:   cassete/runtime"
  echo "   Provider:  cassete/$PROVIDER"
  echo "   Entity:    $ENTITY ($ENTITY_NS)"
  echo ""
  echo "📦 Resolvendo dependências..."
  
  MAX_ATTEMPTS=50
  ATTEMPT=0
  
  while [[ $ATTEMPT -lt $MAX_ATTEMPTS ]]; do
    ATTEMPT=$((ATTEMPT + 1))
    
    COMPOSER_OUTPUT=$(cd "$DL_PATH" && composer update --no-interaction 2>&1) && break
    
    MISSING=$(echo "$COMPOSER_OUTPUT" | grep -oP "[a-z0-9_-]+/[a-z0-9_-]+(?= @dev -> could not be found)" | head -1)
    
    if [[ -z "$MISSING" ]]; then
      cleanup_and_exit "Erro não tratável:\n$COMPOSER_OUTPUT" "$DL_PATH"
    fi
    
    echo "   ➕ [$ATTEMPT] $MISSING"
    
    if ! add_dependency "$MISSING"; then
      cleanup_and_exit "Não foi possível resolver: $MISSING\n   rode 'recompose scan' pra verificar se existe" "$DL_PATH"
    fi
    
    write_composer
  done
  
  if [[ $ATTEMPT -ge $MAX_ATTEMPTS ]]; then
    cleanup_and_exit "Máximo de tentativas atingido ($MAX_ATTEMPTS)" "$DL_PATH"
  fi
  
  echo ""
  echo "✅ data criado: $DL_PATH"
  echo "   Dependências resolvidas em $ATTEMPT tentativa(s)"
  
  echo ""
  run_test "$DL_PATH"
}

# ============================================================
# MAIN
# ============================================================

if [[ -z "$CMD" ]]; then
  show_help
  exit 0
fi

case "$CMD" in
  test)
    run_test "$2"
    ;;
  list)
    run_list "$2"
    ;;
  -h|--help|help)
    show_help
    ;;
  *)
    run_create "$CMD" "$2"
    ;;
esac
